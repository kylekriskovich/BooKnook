# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Host-side port to publish the app on (adjust if it collides with something else on the server)
TBR_PORT=8011

# Base URL of your Grimmory instance — TBR sends login attempts here. Required for users to be
# able to log in at all.
GRIMMORY_BASE_URL=https://grimmory.example.com

# Random secret used to sign session cookies so they can't be edited client-side to impersonate
# another user. Generate one locally, e.g.: openssl rand -hex 32
TBR_SECRET_KEY=

# Grimmory username of the app's admin — their nav settings icon shortcuts to /admin.
TBR_ADMIN_USERNAME=

# Library cross-check (phase 2, optional) is configured from within the app at /admin/settings,
# not via environment variables.
